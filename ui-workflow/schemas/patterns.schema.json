{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Patterns — 跨 app 归纳出的共识与分歧（阶段 2 产物）",
  "type": "object",
  "additionalProperties": false,
  "required": ["screens"],
  "properties": {
    "screens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen_id", "apps", "consensus", "decisions"],
        "properties": {
          "screen_id": {"type": "string"},
          "apps": {"type": "array", "items": {"type": "string"}, "description": "参与归纳的不同 app"},
          "consensus": {
            "type": "array",
            "description": "≥ 2/3 的参考都这么做的事",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pattern", "evidence"],
              "properties": {
                "pattern": {"type": "string"},
                "evidence": {"type": "array", "minItems": 2, "items": {"type": "string"}, "description": "analysis id"}
              }
            }
          },
          "divergences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["question", "options"],
              "properties": {
                "question": {"type": "string"},
                "options": {
                  "type": "array", "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["choice", "evidence"],
                    "properties": {
                      "choice": {"type": "string"},
                      "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                    }
                  }
                }
              }
            }
          },
          "decisions": {
            "type": "array", "minItems": 1,
            "description": "本产品采用什么，以及为什么（必须联系 brief 的 core_tasks / audience）",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["decision", "because"],
              "properties": {
                "decision": {"type": "string"},
                "because": {"type": "string"},
                "evidence": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
