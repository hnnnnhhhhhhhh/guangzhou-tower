{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Screen analysis — 单张参考截图的结构化读图结果（阶段 2 产物）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "for_screen", "screen_type", "frame", "regions", "primary_action", "density"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "= 截图文件名去扩展名"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "via"],
      "properties": {
        "app": {"type": "string"},
        "url": {"type": "string"},
        "via": {"enum": ["mobbin-mcp", "manual-export", "other"]},
        "file": {"type": "string", "description": "refs/shots/ 下的文件名"}
      }
    },
    "for_screen": {"type": "string", "description": "对应 brief.screens[].id"},
    "screen_type": {"type": "string", "description": "如 home / list / detail / form / onboarding / empty-state"},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "navigation"],
      "properties": {
        "header": {"enum": ["none", "large-title", "compact-title", "search", "custom"]},
        "navigation": {"enum": ["bottom-tabs", "top-tabs", "drawer", "stack-only", "none"]},
        "floating_action": {"type": "boolean"}
      }
    },
    "regions": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "description": "从上到下的内容分区。只描述结构与信息，不描述像素",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "role", "content_shape", "share_of_screen"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "description": "这个区在帮用户做什么，如 今日进度总览 / 待完成清单"},
          "content_shape": {
            "type": "array", "minItems": 1,
            "items": {"enum": ["title", "text", "value", "ratio", "status", "tag", "time", "person", "media", "enum-choice", "boolean", "action", "input", "collection", "object", "sequence", "feedback", "empty"]}
          },
          "collection_layout": {"enum": ["rows", "cards-vertical", "cards-horizontal", "grid", "none"]},
          "share_of_screen": {"enum": ["small", "medium", "large"], "description": "<15% / 15-40% / >40% 的首屏高度"},
          "item_fields": {"type": "array", "items": {"type": "string"}, "description": "集合里每一项显示哪些字段"}
        }
      }
    },
    "primary_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_meaning", "placement"],
      "properties": {
        "label_meaning": {"type": "string"},
        "placement": {"enum": ["inline-row", "bottom-bar", "floating", "header", "in-card", "none"]}
      }
    },
    "density": {"enum": ["low", "medium", "high"]},
    "notable": {"type": "array", "maxItems": 3, "items": {"type": "string"}, "description": "这屏做得好的、值得带走的做法"},
    "do_not_copy": {"type": "array", "items": {"type": "string"}, "description": "品牌专属元素：logo、插画、文案、吉祥物"}
  }
}
