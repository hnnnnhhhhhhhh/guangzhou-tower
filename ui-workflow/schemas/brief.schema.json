{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brief — 产品需求（阶段 0 产物）",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "category", "platform", "audience", "core_tasks", "screens", "function_refs", "style_source"],
  "properties": {
    "product": {"type": "string", "minLength": 2, "description": "一句话：这是什么 app"},
    "category": {"type": "string", "description": "功能品类，用来检索参考。英文，如 habit tracker / food delivery"},
    "platform": {"enum": ["ios", "android"]},
    "locale": {"type": "string", "default": "zh-CN"},
    "audience": {"type": "string"},
    "core_tasks": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"type": "string"},
      "description": "用户来这里要完成的事，按重要性排序"
    },
    "screens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "primary_action", "search_terms"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "purpose": {"type": "string"},
          "primary_action": {"type": "string", "description": "这一屏唯一的主操作"},
          "search_terms": {
            "type": "array", "minItems": 1, "items": {"type": "string"},
            "description": "检索这类屏用的英文关键词（Mobbin 的 screen / flow 术语），如 home, checklist, streak"
          }
        }
      }
    },
    "function_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_apps_per_screen"],
      "properties": {
        "min_apps_per_screen": {"type": "integer", "minimum": 3, "description": "每屏至少参考几个不同 app；少于 3 个就是照抄"},
        "seed_apps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "style_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["reference-app", "brand", "preset"], "description": "reference-app = 从某个上线 app 的截图提炼；brand = 用户给了品牌规范；preset = 用内置 Astryx 主题"},
        "value": {"type": "string", "description": "app 名 / 品牌文档路径 / 内置主题 slug"}
      }
    }
  }
}
