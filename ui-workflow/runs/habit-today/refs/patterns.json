      "decisions": [
        {
          "decision": "保留今日进度汇总：完成数 + 细进度条",
          "because": "core_tasks 第 2 条“看一眼今天还剩几个”需要一个不用数行数就能读到的数字",
          "evidence": [
            "anything-today-1",
            "insight-timer-today-1"
          ]
        },
        {
          "decision": "连续天数写在每一项的副文本里，不做全局计数",
          "because": "core_tasks 第 3 条是知道每个习惯坚持了多久；用户只有 3–6 个习惯，逐项看得过来",
          "evidence": [
            "finch-today-1",
            "anything-today-1"
          ]
        },
        {
          "decision": "勾选框放行首",
          "because": "主操作是勾选；习惯名长短不一（有的会换行），放行首位置固定，一列对齐，扫起来最快",
          "evidence": [
            "anything-today-1",
            "numo-today-1"
          ]
        },
        {
          "decision": "不做一周日期条",
          "because": "audience 每次打开不到一分钟、只处理今天；回看历史放到“统计”标签",
          "evidence": [
            "anything-today-1",
            "numo-today-1"
          ]
        },
        {
          "decision": "已完成项留在原位，划掉并变浅，副文本保留连续天数",
          "because": "用户既要看到还剩哪些（core_tasks 第 2 条），也要看到做完的还在（坚持感，第 3 条）；重新排序会让清单每次位置都变",
          "evidence": [
            "finch-today-1",
            "numo-today-1"
          ]
        },
        {
          "decision": "新建放在标题行右侧，用弱化的图标按钮",
          "because": "只有 3–6 个习惯，新建是低频操作，不能抢勾选的注意力",
          "evidence": [
            "finch-today-1"
          ]
        },
        {
          "decision": "底部 3 个标签：今天 / 统计 / 我的",
          "because": "core_tasks 第 3 条需要一个看长期记录的地方，日期条去掉后由“统计”承担",
          "evidence": [
            "me-plus-today-1",
            "numo-today-1"
          ]
        }
